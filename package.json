{
  "name": "resync",
  "version": "0.0.1",
  "private": true,
  "description": "Resync desktop client — CAD file sync with a self-hosted server backend, STEP/SolidWorks 3D preview, and version history.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "viewer:dev": "node src/dev-server.js",
    "package:win": "electron-packager . resync --platform=win32 --arch=x64 --out=../resync-dist --overwrite --prune=true --icon=build/icon.ico"
  },
  "dependencies": {
    "google-auth-library": "^9.14.1",
    "occt-import-js": "^0.0.23",
    "pdfjs-dist": "^6.2.108",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-packager": "^17.1.2"
  }
}
